---
import { getContent, type Lang } from '../i18n';
import { site, formatNumber } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getContent(lang);
const p = t.projects.portfolio;
const sectors = t.about.portfolio.sectors;
const totalLabel = t.about.portfolio.headers.total;

const filters = ['all', 'completed', 'ongoing'] as const;
/** One shared scale so bars stay comparable between filters */
const scale = Math.max(...site.portfolio.rows.map((row) => row.projects));
const percent = (n: number) => ((n / scale) * 100).toFixed(1);
---

<div data-chart data-filter="all" data-reveal="fade" class="card p-5 sm:p-8">
  <div class="flex flex-col gap-5 md:flex-row md:items-center md:justify-between">
    <div class="chart-filters flex-wrap gap-2" role="group" aria-label={p.title}>
      {
        filters.map((f, i) => (
          <button type="button" class="filter-btn" data-filter-btn={f} aria-pressed={i === 0 ? 'true' : 'false'}>
            {p.filters[f]}
          </button>
        ))
      }
    </div>
    <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm font-medium text-night-800" aria-hidden="true">
      <li class="flex items-center gap-2"><span class="h-3 w-3 rounded-full bg-gold-500"></span>{p.filters.completed}</li>
      <li class="flex items-center gap-2"><span class="h-3 w-3 rounded-full bg-night-700"></span>{p.filters.ongoing}</li>
    </ul>
  </div>

  <ul class="mt-6 divide-y divide-cream-200">
    {
      site.portfolio.rows.map((row) => (
        <li class="chart-row" data-all={row.projects} data-completed={row.completed} data-ongoing={row.ongoing}>
          <div class="flex items-baseline justify-between gap-4">
            <span class="font-semibold text-night-900">{sectors[row.id]}</span>
            <span class="tabular font-display text-xl font-bold text-night-900" data-value>
              {row.projects}
            </span>
          </div>
          <div class="bar-track grow-line mt-2.5" style={`--done:${percent(row.completed)};--ongoing:${percent(row.ongoing)}`}>
            <span class="bar-seg bar-done"></span>
            <span class="bar-seg bar-ongoing"></span>
          </div>
          <p class="mt-2 text-sm text-muted">
            {p.valueLabel}: <span class="tabular font-semibold text-night-800" dir="ltr">{formatNumber(row.valueOMR)}</span>
          </p>
        </li>
      ))
    }
  </ul>

  <div
    class="mt-2 flex items-baseline justify-between gap-4 rounded-xl bg-sage-300/40 px-4 py-4"
    data-total
    data-all={site.portfolio.totals.projects}
    data-completed={site.portfolio.totals.completed}
    data-ongoing={site.portfolio.totals.ongoing}
  >
    <span class="font-bold text-night-950">{totalLabel}</span>
    <span class="tabular font-display text-2xl font-bold text-night-950" data-value>{site.portfolio.totals.projects}</span>
  </div>
  <p class="mt-4 text-sm text-muted">{p.note}</p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-chart]').forEach((root) => {
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-filter-btn]'));
    const rows = Array.from(root.querySelectorAll<HTMLElement>('.chart-row, [data-total]'));

    const apply = (filter: string) => {
      root.dataset.filter = filter;
      buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.filterBtn === filter)));
      rows.forEach((row) => {
        const value = row.querySelector<HTMLElement>('[data-value]');
        if (value) value.textContent = row.dataset[filter] ?? '';
      });
    };

    buttons.forEach((button) => button.addEventListener('click', () => apply(button.dataset.filterBtn!)));
  });
</script>
