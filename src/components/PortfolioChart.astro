---
import Icon from './Icon.astro';
import type { IconName } from './icons';
import { getContent, type Lang } from '../i18n';
import { site, formatNumber, type PortfolioId } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getContent(lang);
const { headers, sectors, note } = t.about.portfolio;
const { rows, totals } = site.portfolio;

const sectorIcons: Record<PortfolioId, IconName> = {
  civil: 'crane',
  electrical: 'bolt',
  telecom: 'network',
  utilities: 'droplet',
  water: 'waterTower',
};

/** Rial amounts are written the way they appear on the company's documents: 2,026,097/= */
const omr = (value: number) => `${formatNumber(value)}/=`;

const countCols: { key: 'projects' | 'completed' | 'ongoing'; icon: IconName }[] = [
  { key: 'projects', icon: 'clipboard' },
  { key: 'completed', icon: 'checkCircle' },
  { key: 'ongoing', icon: 'clock' },
];
---

<div data-reveal="fade">
  <div class="card overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full min-w-[48rem] text-start text-[0.95rem]">
        <thead class="bg-night-900 whitespace-nowrap text-white">
          <tr>
            <th scope="col" class="px-6 py-4 text-start font-semibold">
              <span class="inline-flex items-center gap-2.5">
                <Icon name="building" size={20} class="shrink-0 text-gold-400" />
                {headers.sector}
              </span>
            </th>
            {
              countCols.map((col) => (
                <th scope="col" class="px-4 py-4 text-center font-semibold">
                  <span class="inline-flex items-center gap-2">
                    <Icon name={col.icon} size={18} class="shrink-0 text-gold-400" />
                    {headers[col.key]}
                  </span>
                </th>
              ))
            }
            <th scope="col" class="px-6 py-4 text-end font-semibold">
              <span class="inline-flex items-center gap-2">
                <Icon name="chart" size={18} class="shrink-0 text-gold-400" />
                {headers.value}
              </span>
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-cream-200">
          {
            rows.map((row) => (
              <tr class="transition-colors hover:bg-cream-50">
                <th scope="row" class="px-6 py-4 text-start font-semibold text-night-900">
                  <span class="flex items-center gap-3">
                    <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-night-900 text-gold-400">
                      <Icon name={sectorIcons[row.id]} size={20} />
                    </span>
                    {sectors[row.id]}
                  </span>
                </th>
                <td class="tabular px-4 py-4 text-center font-semibold text-night-900">{row.projects}</td>
                <td class="tabular px-4 py-4 text-center">{row.completed}</td>
                <td class="tabular px-4 py-4 text-center">{row.ongoing}</td>
                <td class="tabular px-6 py-4 text-end font-semibold text-night-900">
                  <span dir="ltr" class="inline-block">{omr(row.valueOMR)}</span>
                </td>
              </tr>
            ))
          }
        </tbody>
        <tfoot class="bg-sage-300/40 font-bold text-night-950">
          <tr>
            <th scope="row" class="px-6 py-4 text-start">
              <span class="flex items-center gap-3">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-night-900 text-gold-400">
                  <Icon name="sigma" size={20} />
                </span>
                {headers.total}
              </span>
            </th>
            <td class="tabular px-4 py-4 text-center">{totals.projects}</td>
            <td class="tabular px-4 py-4 text-center">{totals.completed}</td>
            <td class="tabular px-4 py-4 text-center">{totals.ongoing}</td>
            <td class="tabular px-6 py-4 text-end"><span dir="ltr" class="inline-block">{omr(totals.valueOMR)}</span></td>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>
  <p class="mt-5 flex items-start gap-3 text-sm text-muted">
    <Icon name="shield" size={20} class="mt-0.5 shrink-0 text-gold-600" />
    {note}
  </p>
</div>
