---
import Icon from './Icon.astro';
import { getContent, pagePath, type Lang } from '../i18n';
import { site } from '../data/site';
import { rv } from '../lib/reveal';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getContent(lang);
const whatsappHref = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(t.contact.whatsapp.prefill)}`;
---

<section class="relative overflow-hidden bg-night-800 text-white">
  <div class="container-x relative py-14 md:py-20">
    <div
      class="pointer-events-none absolute -start-24 top-1/2 h-72 w-72 -translate-y-1/2 rounded-full border-[14px] border-dashed border-gold-400 opacity-[0.07]"
      aria-hidden="true"
    >
    </div>
    <div class="relative flex flex-col items-start justify-between gap-8 md:flex-row md:items-center md:gap-16">
      <div {...rv(0, 'start')} class="max-w-2xl">
        <h2 class="h-display text-3xl sm:text-4xl xl:text-[2.75rem]">{t.home.cta.title}</h2>
        <p class="prose-lead mt-4 !text-white/75">{t.home.cta.text}</p>
      </div>
      <div {...rv(1, 'end')} class="flex flex-wrap gap-3">
        <a href={pagePath(lang, 'contact')} class="btn btn-primary">
          {t.ui.contactUs}
          <Icon name="arrow" size={18} class="icon-arrow rtl:-scale-x-100" />
        </a>
        <a href={whatsappHref} class="btn btn-outline-light" target="_blank" rel="noopener noreferrer">
          <Icon name="whatsapp" size={18} />
          {t.ui.chatOnWhatsapp}
        </a>
      </div>
    </div>
  </div>
</section>
