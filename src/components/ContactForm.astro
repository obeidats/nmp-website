---
import { getContent, type Lang } from '../i18n';
import { site } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const f = getContent(lang).contact.form;

const field =
  'mt-2 block w-full rounded-lg border border-cream-300 bg-white px-4 py-3 text-night-900 placeholder:text-muted/60 focus:border-gold-500 focus:outline-none focus:ring-2 focus:ring-gold-500/30';
const label = 'block text-sm font-semibold text-night-900';
---

<form
  data-contact-form
  data-endpoint={site.form.endpoint}
  data-access-key={site.form.accessKey}
  data-email={site.email}
  data-mail-subject={f.mailSubject}
  data-sending={f.sending}
  data-submit={f.submit}
  data-success={f.success}
  data-error={f.error}
  data-mailto-note={f.mailtoNote}
  method="post"
  class="card p-6 sm:p-8"
>
  <h2 class="h-display text-2xl text-night-900">{f.title}</h2>

  <div class="mt-6 grid gap-5 sm:grid-cols-2">
    <div>
      <label for="cf-name" class={label}>{f.name}</label>
      <input id="cf-name" name="name" type="text" required autocomplete="name" class={field} />
    </div>
    <div>
      <label for="cf-company" class={label}>
        {f.company} <span class="font-normal text-muted">({f.optional})</span>
      </label>
      <input id="cf-company" name="company" type="text" autocomplete="organization" class={field} />
    </div>
    <div>
      <label for="cf-email" class={label}>{f.email}</label>
      <input id="cf-email" name="email" type="email" required autocomplete="email" dir="ltr" class={`${field} text-start`} />
    </div>
    <div>
      <label for="cf-phone" class={label}>
        {f.phone} <span class="font-normal text-muted">({f.optional})</span>
      </label>
      <input id="cf-phone" name="phone" type="tel" autocomplete="tel" dir="ltr" class={`${field} text-start`} />
    </div>
    <div class="sm:col-span-2">
      <label for="cf-topic" class={label}>{f.topic}</label>
      <select id="cf-topic" name="topic" class={field}>
        {f.topicOptions.map((o) => <option value={o}>{o}</option>)}
      </select>
    </div>
    <div class="sm:col-span-2">
      <label for="cf-message" class={label}>{f.message}</label>
      <textarea id="cf-message" name="message" rows="6" required class={field}></textarea>
    </div>
  </div>

  <!-- Honeypot: hidden from people, tempting to bots -->
  <div class="sr-only" aria-hidden="true">
    <label>Leave this empty<input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
  </div>

  <div class="mt-7 flex flex-wrap items-center gap-4">
    <button type="submit" class="btn btn-primary" data-submit-button>{f.submit}</button>
    <p data-status role="status" aria-live="polite" class="text-sm font-medium"></p>
  </div>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');

  if (form) {
    const button = form.querySelector<HTMLButtonElement>('[data-submit-button]')!;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const d = form.dataset;

    const say = (message: string, ok: boolean) => {
      status.textContent = message;
      status.className = `text-sm font-medium ${ok ? 'text-sage-500' : 'text-red-700'}`;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
      if (data._gotcha) return; // bot
      delete data._gotcha;

      // No form service configured yet: hand the message to the visitor's email app.
      if (!d.endpoint) {
        const labelOf = (id: string) =>
          form.querySelector(`label[for=${id}]`)?.firstChild?.textContent?.trim() ?? id;
        const lines = [
          `${labelOf('cf-name')}: ${data.name}`,
          data.company ? `${labelOf('cf-company')}: ${data.company}` : '',
          `${labelOf('cf-email')}: ${data.email}`,
          data.phone ? `${labelOf('cf-phone')}: ${data.phone}` : '',
        ].filter(Boolean);
        const body = [...lines, '', data.message].join('\n');
        const subject = `${d.mailSubject} — ${data.topic}`;
        window.location.href = `mailto:${d.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        say(d.mailtoNote!, true);
        return;
      }

      button.disabled = true;
      button.textContent = d.sending!;
      say('', true);
      try {
        const response = await fetch(d.endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            ...data,
            access_key: d.accessKey || undefined,
            subject: `${d.mailSubject} — ${data.topic}`,
            from_name: 'NM Projects website',
          }),
        });
        if (!response.ok) throw new Error(String(response.status));
        form.reset();
        say(d.success!, true);
      } catch {
        say(d.error!, false);
      } finally {
        button.disabled = false;
        button.textContent = d.submit!;
      }
    });
  }
</script>
