---
import Icon from './Icon.astro';

interface Props {
  labels: { close: string; prev: string; next: string };
}

const { labels } = Astro.props;
---

<!--
  One shared photo viewer. Any element with data-lightbox="<group>", data-src and data-caption
  opens it; previous/next stay inside the same group.
-->
<dialog class="lb" data-lb aria-labelledby="lb-caption">
  <button type="button" data-lb-close aria-label={labels.close} class="lb-btn end-4 top-4">
    <Icon name="close" size={22} />
  </button>
  <button
    type="button"
    data-lb-prev
    aria-label={labels.prev}
    class="lb-btn start-4 bottom-4 sm:top-1/2 sm:bottom-auto sm:-translate-y-1/2"
  >
    <Icon name="arrow" size={22} class="rotate-180 rtl:rotate-0" />
  </button>
  <button
    type="button"
    data-lb-next
    aria-label={labels.next}
    class="lb-btn end-4 bottom-4 sm:top-1/2 sm:bottom-auto sm:-translate-y-1/2"
  >
    <Icon name="arrow" size={22} class="rtl:rotate-180" />
  </button>
  <figure>
    <img data-lb-img alt="" />
    <figcaption id="lb-caption" data-lb-caption></figcaption>
  </figure>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lb]');

  if (dialog) {
    const img = dialog.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-lb-caption]')!;
    const prev = dialog.querySelector<HTMLElement>('[data-lb-prev]')!;
    const next = dialog.querySelector<HTMLElement>('[data-lb-next]')!;
    const rtl = document.documentElement.dir === 'rtl';

    let group: HTMLElement[] = [];
    let index = 0;

    const show = (i: number) => {
      index = (i + group.length) % group.length;
      const el = group[index]!;
      img.src = el.dataset.src!;
      img.alt = el.dataset.caption ?? '';
      caption.textContent = el.dataset.caption ?? '';
    };
    const step = (delta: number) => group.length > 1 && show(index + delta);

    document.addEventListener('click', (event) => {
      const trigger = (event.target as HTMLElement).closest<HTMLElement>('[data-lightbox]');
      if (!trigger) return;
      group = Array.from(document.querySelectorAll<HTMLElement>(`[data-lightbox="${trigger.dataset.lightbox}"]`));
      prev.hidden = next.hidden = group.length < 2;
      show(group.indexOf(trigger));
      dialog.showModal();
    });

    prev.addEventListener('click', () => step(-1));
    next.addEventListener('click', () => step(1));
    dialog.querySelector('[data-lb-close]')!.addEventListener('click', () => dialog.close());

    // Click outside the photo closes it
    dialog.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      if (!target.closest('img') && !target.closest('button')) dialog.close();
    });

    dialog.addEventListener('keydown', (event) => {
      if (event.key === (rtl ? 'ArrowLeft' : 'ArrowRight')) step(1);
      else if (event.key === (rtl ? 'ArrowRight' : 'ArrowLeft')) step(-1);
    });

    // Swipe on touch screens
    let startX = 0;
    dialog.addEventListener('touchstart', (event) => (startX = event.touches[0]!.clientX), { passive: true });
    dialog.addEventListener('touchend', (event) => {
      const dx = event.changedTouches[0]!.clientX - startX;
      if (Math.abs(dx) > 50) step((dx < 0 ? 1 : -1) * (rtl ? -1 : 1));
    });

    dialog.addEventListener('close', () => img.removeAttribute('src'));
  }
</script>
