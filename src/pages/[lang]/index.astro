---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { getContent, pagePath, staticLangPaths, type Lang } from '../../i18n';
import { site, projectIds } from '../../data/site';
import { covers, photos } from '../../data/images';
import { rv } from '../../lib/reveal';

export const getStaticPaths = staticLangPaths;

const lang = Astro.params.lang as Lang;
const t = getContent(lang);
const h = t.home;
const ps = t.projects.portfolio.stats;

const millions = site.portfolio.totals.valueOMR / 1_000_000;

/** `from` / `to` drive the count-up animation; `text` is what shows without JavaScript. */
const stats = [
  { text: String(site.established), to: site.established, from: 2000, decimals: 0, suffix: '', label: h.stats.established },
  { text: String(site.portfolio.totals.projects), to: site.portfolio.totals.projects, from: 0, decimals: 0, suffix: '', label: h.stats.projects },
  { text: String(site.portfolio.totals.ongoing), to: site.portfolio.totals.ongoing, from: 0, decimals: 0, suffix: '', label: h.stats.ongoing },
  {
    text: `${millions.toFixed(2)}${h.stats.millionSuffix}`,
    to: Number(millions.toFixed(2)),
    from: 0,
    decimals: 2,
    suffix: h.stats.millionSuffix,
    label: h.stats.value,
  },
];

const projectsHref = pagePath(lang, 'projects');
---

<BaseLayout lang={lang} page="home" title={h.seoTitle}>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-night-900 text-white">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(55%_70%_at_82%_30%,rgb(196_150_74/0.14),transparent_70%)] rtl:bg-[radial-gradient(55%_70%_at_18%_30%,rgb(196_150_74/0.14),transparent_70%)]"
      aria-hidden="true"
    >
    </div>

    <div class="container-x relative flex min-h-[calc(100svh-5rem)] flex-col justify-center gap-8 py-10 md:py-12 xl:gap-14">
      <div class="grid items-center gap-10 lg:grid-cols-[1.05fr_0.95fr] xl:gap-20">
        <div>
          <p class="eyebrow rise mb-6 text-gold-400" style="--d:100ms">{h.hero.eyebrow}</p>
          <h1 class="h-display text-5xl sm:text-6xl 2xl:text-7xl">
            <span class="line-mask"><span class="line-in" style="--d:200ms">{h.hero.titleLead}</span></span>
            <span class="line-mask text-gold-400"><span class="line-in" style="--d:340ms">{h.hero.titleAccent}</span></span>
          </h1>
          <p class="rise mt-5 text-sm font-semibold tracking-wider text-gold-300 uppercase" style="--d:520ms">{h.hero.subtitle}</p>
          <p class="prose-lead rise mt-6 max-w-xl !text-white/80" style="--d:620ms">{h.hero.text}</p>
          <div class="rise mt-7 flex flex-wrap gap-3" style="--d:740ms">
            <a href={pagePath(lang, 'services')} class="btn btn-primary">
              {t.ui.exploreServices}
              <Icon name="arrow" size={18} class="icon-arrow rtl:-scale-x-100" />
            </a>
            <a href={projectsHref} class="btn btn-outline-light">{t.ui.exploreProjects}</a>
          </div>
          <p class="rise mt-7 border-s-2 border-gold-500 ps-4 font-display text-lg font-semibold text-gold-300" style="--d:880ms">
            {h.hero.tagline}
          </p>
        </div>

        <div class="rise" style="--d:500ms" data-parallax="0.07" aria-hidden="true">
          <div class="relative mx-auto w-full max-w-xl lg:max-w-[26rem] xl:max-w-[30rem]">
            <div class="absolute -inset-3 hidden translate-x-5 translate-y-5 rounded-[2rem] border border-gold-500/50 lg:block rtl:-translate-x-5"></div>
            <div class="photo relative h-56 !rounded-[2rem] sm:h-72 lg:h-[min(34rem,56svh)]">
              <img
                src={photos.heroBridge.src}
                width={photos.heroBridge.width}
                height={photos.heroBridge.height}
                alt=""
                fetchpriority="high"
                class="object-[50%_30%]"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-night-950/60 via-transparent to-night-950/10"></div>
            </div>
            <div
              class="absolute -bottom-5 -start-4 hidden items-center gap-4 rounded-xl border border-gold-500/40 bg-night-950/90 px-5 py-4 shadow-xl backdrop-blur lg:flex xl:-start-8"
            >
              <span class="flex h-11 w-11 items-center justify-center rounded-full border border-gold-500/70 text-gold-400">
                <Icon name="award" size={22} />
              </span>
              <div>
                <p class="h-display text-lg text-white">{t.ui.establishedLabel} <span dir="ltr">{site.established}</span></p>
                <p class="text-xs text-white/65">{t.ui.crLabel}: <span dir="ltr">{site.commercialRegistration}</span></p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <dl
        class="rise grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-white/10 bg-white/10 md:grid-cols-4"
        style="--d:1000ms"
      >
        {
          stats.map((s) => (
            <div class="flex flex-col-reverse gap-1 bg-night-900/95 px-5 py-4 md:px-7 md:py-5">
              <dt class="text-sm text-white/70">{s.label}</dt>
              <dd
                class="h-display tabular text-3xl text-gold-400 md:text-4xl"
                data-count
                data-to={s.to}
                data-from={s.from}
                data-decimals={s.decimals}
                data-suffix={s.suffix}
              >
                {s.text}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Intro + the three service pillars -->
  <Section tone="light">
    <div class="grid items-start gap-12 lg:grid-cols-[0.9fr_1.1fr] xl:gap-20">
      <div>
        <SectionHeading kicker={h.intro.kicker} title={h.intro.title} text={h.intro.text} />
        <p {...rv(1)} class="mt-6 border-s-4 border-gold-500 ps-5 text-lg font-medium text-night-800">{h.intro.highlight}</p>
        <a {...rv(2)} href={pagePath(lang, 'about')} class="btn btn-outline-dark mt-8">
          {t.ui.aboutUs}
          <Icon name="arrow" size={18} class="icon-arrow rtl:-scale-x-100" />
        </a>
      </div>

      <ul class="space-y-4">
        {
          h.services.items.map((s, i) => (
            <li {...rv(i, 'end')} class="card card-hover flex items-start gap-5 p-6">
              <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-night-900 text-gold-400">
                <Icon name={s.icon!} size={28} />
              </span>
              <div class="min-w-0 flex-1">
                <div class="flex items-baseline justify-between gap-4">
                  <h3 class="h-display text-xl text-night-900">{s.title}</h3>
                  <span class="font-display text-2xl font-bold text-cream-300" aria-hidden="true">0{i + 1}</span>
                </div>
                <p class="mt-2 text-[0.95rem] text-muted">{s.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <!-- Capabilities: one photo card per discipline, each opening its section on the Projects page -->
  <Section tone="dark">
    <SectionHeading tone="dark" layout="split" kicker={h.capabilities.kicker} title={h.capabilities.title} text={h.capabilities.text} />
    <ul class="mt-12 grid grid-cols-2 gap-4 lg:grid-cols-5">
      {
        h.capabilities.items.map((c, i) => {
          const id = projectIds[i]!;
          return (
            <li {...rv(i, 'pop')} class:list={[i === 4 && 'col-span-2 lg:col-span-1']}>
              <a
                href={`${projectsHref}#${id}`}
                class:list={[
                  'group relative block overflow-hidden rounded-2xl border border-white/10 transition-colors hover:border-gold-500/70',
                  i === 4 ? 'aspect-[16/9] lg:aspect-[3/4]' : 'aspect-[3/4]',
                ]}
              >
                <div class="photo absolute inset-0 !rounded-none">
                  <img src={covers[id].src} width={covers[id].width} height={covers[id].height} alt="" loading="lazy" decoding="async" />
                </div>
                <div class="absolute inset-0 bg-gradient-to-t from-night-950/95 via-night-950/45 to-night-950/5"></div>
                <div class="absolute inset-x-0 bottom-0 p-4 sm:p-5">
                  <span class="flex h-11 w-11 items-center justify-center rounded-full border border-gold-500/80 bg-night-950/60 text-gold-400 transition-colors group-hover:bg-gold-500 group-hover:text-night-950">
                    <Icon name={c.icon!} size={22} />
                  </span>
                  <h3 class="h-display mt-3 text-lg">{c.title}</h3>
                  <p class="mt-1 hidden text-sm text-white/75 sm:block">{c.text}</p>
                </div>
              </a>
            </li>
          );
        })
      }
    </ul>
    <div class="mt-10 flex flex-wrap gap-3" data-reveal="fade">
      <a href={pagePath(lang, 'services')} class="btn btn-primary">
        {t.ui.exploreServices}
        <Icon name="arrow" size={18} class="icon-arrow rtl:-scale-x-100" />
      </a>
      <a href={projectsHref} class="btn btn-outline-light">{t.ui.exploreProjects}</a>
    </div>
  </Section>

  <!-- Approach -->
  <Section tone="cream">
    <SectionHeading layout="center" title={h.approach.title} />
    <ol class="mt-14 grid gap-10 md:grid-cols-3 md:gap-10">
      {
        h.approach.steps.map((s, i) => (
          <li {...rv(i)} class="relative pt-8">
            <span class="absolute inset-x-0 top-0 h-px bg-night-900/15" />
            <span class="grow-line absolute start-0 top-[-1px] h-[3px] w-20 bg-gold-500" />
            <div class="flex items-center justify-between">
              <span class="font-display text-5xl font-bold text-cream-300" aria-hidden="true">0{i + 1}</span>
              <span class="flex h-14 w-14 items-center justify-center rounded-full bg-night-900 text-gold-400">
                <Icon name={s.icon!} size={26} />
              </span>
            </div>
            <h3 class="h-display mt-5 text-xl text-night-900">{s.title}</h3>
            <p class="mt-2 text-muted">{s.text}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <!-- Regional -->
  <Section tone="light">
    <div class="grid items-center gap-10 lg:grid-cols-2 xl:gap-20">
      <div>
        <SectionHeading kicker={h.region.kicker} title={h.region.title} text={h.region.text} />
        <p class="mt-6 font-display text-lg font-semibold text-gold-700" data-reveal="fade">{h.region.tagline}</p>
      </div>
      <div {...rv(0, 'end')} class="photo aspect-[16/10]">
        <img
          src={photos.muscat.src}
          width={photos.muscat.width}
          height={photos.muscat.height}
          alt=""
          loading="lazy"
          decoding="async"
          class="object-[50%_40%]"
        />
      </div>
    </div>

    <div class="relative mt-14" data-reveal="fade">
      <div class="absolute inset-x-[12.5%] top-7 hidden h-px bg-gold-500/40 md:block" aria-hidden="true">
        <div class="grow-line h-full bg-gold-500"></div>
      </div>
      <ol class="grid gap-8 sm:grid-cols-2 md:grid-cols-4">
        {
          h.region.items.map((r, i) => (
            <li {...rv(i)} class="relative text-center">
              <span class="relative z-10 mx-auto flex h-14 w-14 items-center justify-center rounded-full border border-gold-500 bg-cream-50 text-gold-700">
                <Icon name={r.icon!} size={24} />
              </span>
              <h3 class="h-display mt-4 text-lg text-night-900">{r.title}</h3>
              <p class="mx-auto mt-1 max-w-[16rem] text-sm text-muted">{r.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </Section>

  <!-- Projects band -->
  <section class="relative isolate overflow-hidden bg-night-950 text-white">
    <img
      src={covers.roads.src}
      width={covers.roads.width}
      height={covers.roads.height}
      alt=""
      loading="lazy"
      decoding="async"
      class="absolute inset-0 -z-20 h-full w-full object-cover opacity-45"
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-night-950 via-night-950/85 to-night-950/20 rtl:bg-gradient-to-l"></div>
    <div class="container-x py-16 md:py-24">
      <div class="max-w-2xl">
        <SectionHeading tone="dark" kicker={h.projectsBand.kicker} title={h.projectsBand.title} text={h.projectsBand.text} />
        <ul {...rv(1)} class="mt-8 flex flex-wrap gap-x-8 gap-y-3 text-white/85">
          <li>
            <span class="h-display tabular text-2xl text-gold-400">{site.portfolio.totals.projects}</span>
            <span class="ms-2 text-sm">{ps.projects}</span>
          </li>
          <li>
            <span class="h-display tabular text-2xl text-gold-400">{site.portfolio.totals.completed}</span>
            <span class="ms-2 text-sm">{ps.completed}</span>
          </li>
          <li>
            <span class="h-display tabular text-2xl text-gold-400">{site.portfolio.totals.ongoing}</span>
            <span class="ms-2 text-sm">{ps.ongoing}</span>
          </li>
        </ul>
        <a {...rv(2)} href={projectsHref} class="btn btn-primary mt-9">
          {t.ui.exploreProjects}
          <Icon name="arrow" size={18} class="icon-arrow rtl:-scale-x-100" />
        </a>
      </div>
    </div>
  </section>

  <CtaBand lang={lang} />
</BaseLayout>
